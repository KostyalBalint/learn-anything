---
import { render } from 'astro:content';
import { Icon } from 'astro-icon/components';
import PageLayout from '../../layouts/PageLayout.astro';
import { flatPages } from '../../lib/nav';

// A rest param, because a page in a section has a two-segment slug
// (`networking/01-services`).
export async function getStaticPaths() {
  const pages = await flatPages();
  return pages.map((page, i) => ({
    params: { subject: page.subject.slug, page: page.slug },
    props: {
      page,
      // The nav is already fully ordered, so prev/next are free.
      prev: i > 0 && pages[i - 1]!.subject.slug === page.subject.slug ? pages[i - 1] : undefined,
      next:
        i < pages.length - 1 && pages[i + 1]!.subject.slug === page.subject.slug
          ? pages[i + 1]
          : undefined,
    },
  }));
}

const { page, prev, next } = Astro.props;
const { section, subject } = page;
const { Content } = await render(page.entry);
---

<PageLayout title={page.title} description={page.summary}>
  <article class="prose prose-slate max-w-none dark:prose-invert prose-headings:scroll-mt-24">
    <p
      data-pagefind-ignore
      class="mb-1 flex flex-wrap items-center gap-1.5 text-sm font-medium text-brand-600 dark:text-brand-100"
    >
      <Icon name={`lucide:${subject.icon}`} class="size-4" />
      {subject.title}
      {
        section && (
          <>
            <Icon name="lucide:chevron-right" class="size-3.5 text-slate-400" />
            <Icon name={`lucide:${section.icon}`} class="size-4" />
            {section.title}
          </>
        )
      }
    </p>
    <h1>{page.title}</h1>
    {page.summary && <p class="lead text-lg text-slate-600 dark:text-slate-400">{page.summary}</p>}
    <Content />
  </article>

  <nav
    data-pagefind-ignore
    aria-label="Pagination"
    class="mt-12 flex gap-4 border-t border-slate-200 pt-6 dark:border-slate-800"
  >
    {
      prev && (
        <a
          href={prev.href}
          class="flex-1 rounded-xl border border-slate-200 p-4 hover:border-brand-500 dark:border-slate-800"
        >
          <span class="flex items-center gap-1 text-xs uppercase tracking-wide text-slate-400">
            <Icon name="lucide:arrow-left" class="size-3.5" />
            Previous
          </span>
          <span class="font-medium">{prev.title}</span>
        </a>
      )
    }
    {
      next && (
        <a
          href={next.href}
          class="flex-1 rounded-xl border border-slate-200 p-4 text-right hover:border-brand-500 dark:border-slate-800"
        >
          <span class="flex items-center justify-end gap-1 text-xs uppercase tracking-wide text-slate-400">
            Next
            <Icon name="lucide:arrow-right" class="size-3.5" />
          </span>
          <span class="font-medium">{next.title}</span>
        </a>
      )
    }
  </nav>
</PageLayout>
