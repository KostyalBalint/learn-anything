---
import { Icon } from 'astro-icon/components';
import PageLayout from '../layouts/PageLayout.astro';
import { buildNav } from '../lib/nav';

const subjects = await buildNav();
---

<PageLayout title="Home" description="A personal study site.">
  <div class="prose prose-slate max-w-none dark:prose-invert">
    <h1>Learn Anything</h1>
    <p class="lead text-lg text-slate-600 dark:text-slate-400">
      Notes I write while learning things. Each subject is a folder of ordered pages.
    </p>
  </div>

  <ul class="not-prose mt-8 grid gap-4 sm:grid-cols-2">
    {
      subjects.map((subject) => (
        <li>
          <a
            href={subject.href}
            class="flex h-full flex-col rounded-xl border border-slate-200 bg-white p-5 transition hover:border-brand-500 hover:shadow-sm dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-500"
          >
            <span class="flex items-center gap-3">
              <span class="flex size-9 items-center justify-center rounded-lg bg-brand-50 text-brand-600 dark:bg-slate-800 dark:text-brand-100">
                <Icon name={`lucide:${subject.icon}`} class="size-5" />
              </span>
              <span class="font-semibold text-slate-900 dark:text-slate-100">{subject.title}</span>
            </span>
            <span class="mt-3 flex-1 text-sm text-slate-600 dark:text-slate-400">
              {subject.summary}
            </span>
            <span class="mt-4 flex items-center gap-1.5 text-xs uppercase tracking-wide text-slate-400">
              <Icon name="lucide:file-text" class="size-3.5" />
              {subject.pages.length} {subject.pages.length === 1 ? 'page' : 'pages'}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    subjects.length === 0 && (
      <p class="mt-8 text-slate-500">
        No subjects yet. Add <code>src/content/subjects/&lt;slug&gt;/_meta.yaml</code> plus an MDX
        page.
      </p>
    )
  }
</PageLayout>
