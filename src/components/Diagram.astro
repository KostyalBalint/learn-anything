---
import { renderMermaid } from '../lib/mermaid';

interface Props {
  /**
   * A Mermaid definition, passed as a template literal:
   * `<Diagram chart={`flowchart LR\n  a --> b`} />`.
   * It must be a prop, not slot content — slot content is HTML-escaped, which
   * mangles Mermaid's `-->` arrows.
   */
  chart: string;
  caption?: string;
}

const { chart, caption } = Astro.props;
const svg = await renderMermaid(chart.trim());
---

<figure class="not-prose my-6">
  <div
    class="mermaid-diagram overflow-x-auto rounded-xl border border-slate-200 bg-white p-4 dark:border-slate-800"
    set:html={svg}
  />
  {
    caption && (
      <figcaption class="mt-2 text-center text-sm text-slate-500 dark:text-slate-400">
        {caption}
      </figcaption>
    )
  }
</figure>
